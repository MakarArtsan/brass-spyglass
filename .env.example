# Переменные окружения Amvera (Настройки → Переменные). Секреты — только там, не в репозитории.

# --- Telegram (https://my.telegram.org → API development tools) ---
TG_API_ID=
TG_API_HASH=
# StringSession юзербота: отдельный аккаунт команды, добавленный в закрытый чат.
# Получить: python backend/scripts/make_session.py (покажет и id чата для TG_CHAT_ID).
TG_SESSION=
# Бот входа (@BotFather). Юзернэйм бота берётся из get_me(), можно не задавать.
TG_BOT_TOKEN=
TG_BOT_USERNAME=
# id закрытого чата команды (формат -100…)
TG_CHAT_ID=
# tg_id владельца: получает роль «Владелец» и может войти даже до подключения юзербота
OWNER_TG_ID=

# --- Сессии ---
# Длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Необязательное ---
# DATA_DIR=/data
# COOKIE_SECURE=true        # на Amvera HTTPS, для локальной разработки по http поставьте false
# FRONTEND_DIR=/app/static
# UPLOAD_CHUNK_MB=8          # размер куска загрузки; если Amvera отвечает 413 на куски — поставьте 1
# SEED_XLSX=                 # пусто — не загружать стартовые данные из Excel; по умолчанию backend/seed/
# TG_PREVIEW_CACHE_MB=500    # кэш просмотра файлов Telegram в окне; лежит на том же диске, что и всё остальное

