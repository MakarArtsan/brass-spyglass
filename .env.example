# Переменные окружения Amvera (Настройки → Переменные). Секреты — только там, не в репозитории.

# --- Telegram (https://my.telegram.org → API development tools) ---
TG_API_ID=
TG_API_HASH=
# StringSession юзербота: отдельный аккаунт команды, добавленный в закрытый чат.
# Получить: python backend/scripts/make_session.py (покажет и id чата для TG_CHAT_ID).
TG_SESSION=
# Бот входа (@BotFather). Юзернэйм бота берётся из get_me(), можно не задавать.
TG_BOT_TOKEN=
TG_BOT_USERNAME=
# id закрытого чата команды (формат -100…): становится чатом первого проекта. Чат каждого проекта
# хранится в самом проекте; вход на сайт открыт тем, кто состоит в чате хотя бы одного проекта.
TG_CHAT_ID=
# tg_id владельца: получает роль «Владелец» и может войти даже до подключения юзербота
OWNER_TG_ID=

# Суперадмины (создают проекты, видят все): tg_id через запятую. OWNER_TG_ID — тоже суперадмин.
# SUPERADMIN_TG_IDS=

# --- Сессии ---
# Длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Необязательное ---
# DATA_DIR=/data
# COOKIE_SECURE=true        # на Amvera HTTPS, для локальной разработки по http поставьте false
# FRONTEND_DIR=/app/static
# UPLOAD_CHUNK_MB=8          # размер куска загрузки; если Amvera отвечает 413 на куски — поставьте 1
# SEED_XLSX=                 # пусто — не загружать стартовые данные из Excel; по умолчанию backend/seed/
# PROJECT_APPROVAL=true      # новые проекты ждут подтверждения суперадмина (до него команда не загружает файлы)
# SELF_SERVICE_PROJECTS=true # любой пользователь Telegram входит и создаёт свой проект; false — только участники чатов
# MAX_PROJECTS_PER_USER=3    # в скольких проектах человек может быть владельцем
# NEW_PROJECT_STORAGE_GB=1   # лимит места нового проекта
# DISK_TOTAL_GB=5            # диск тарифа целиком: общий для всех проектов
# MEMBERS_SYNC_HOURS=6       # как часто участники проектов сверяются со списками их чатов
# MEMBERS_FALLBACK_HOURS=72  # юзербот недоступен: вход по последней проверке не старше этого срока
# EXPORT_FONT=              # шрифт с кириллицей для карточек-заглушек экспорта (по умолчанию DejaVu из образа)
# COMPRESS_IMAGES=true       # false — не сжимать картинки при загрузке (выключатель на случай сбоя)
# ORIGINALS_KEEP_DAYS=7      # сколько дней лежит оригинал картинки до сжатия («Вернуть оригинал»)
# PNGQUANT_BIN=pngquant      # где искать кодировщики сжатия; mozjpeg ставит Dockerfile
# CJPEG_BIN=/opt/mozjpeg/bin/cjpeg
# TG_PREVIEW_CACHE_MB=500    # кэш просмотра файлов Telegram в окне; лежит на том же диске, что и всё остальное

